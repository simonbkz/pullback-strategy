# sweep winners are committed sanitised under config_variants/.
/mt5_runtime.json
/mt5_runtime_*.json
/mt5_runtime_prev.json.bak

# --- daily / weekly generated reports (operational, account-specific) -------
reports/agent_audit/
reports/signal_path/
reports/regime_pulse/
reports/broader_wf/
reports/agent_audit/scratch/
